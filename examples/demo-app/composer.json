{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "fourmix-intelligence/laravel-sdk-demo",
    "description": "Fourmix Intelligence for Laravel の汎用連携を検証する合成データ専用アプリケーション",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "fourmix-intelligence/laravel": "dev-main",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5"
    },
    "repositories": {
        "sdk": { "type": "path", "url": "/sdk", "options": { "symlink": true } }
    },
    "autoload": { "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" } },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
        "test": ["@php artisan config:clear --ansi", "@php artisan test --compact"]
    },
    "config": { "sort-packages": true, "allow-plugins": { "php-http/discovery": false } },
    "minimum-stability": "stable",
    "prefer-stable": true
}
