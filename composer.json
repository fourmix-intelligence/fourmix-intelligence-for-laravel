{
    "name": "fourmix-intelligence/laravel",
    "description": "Fourmix Intelligence を Laravel アプリケーションへ安全に統合する公式パッケージ",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "ai", "agent", "rag", "fourmix-intelligence"],
    "authors": [{"name": "Fourmix Co., Ltd.", "homepage": "https://fourmix.co.jp"}],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {"FourmixIntelligence\\Laravel\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"FourmixIntelligence\\Laravel\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["FourmixIntelligence\\Laravel\\FourmixIntelligenceServiceProvider"],
            "aliases": {"FourmixIntelligence": "FourmixIntelligence\\Laravel\\Facades\\FourmixIntelligence"}
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": ["@validate-package", "@analyse", "@test"],
        "validate-package": "composer validate --strict"
    },
    "config": {"sort-packages": true, "allow-plugins": {"php-http/discovery": false}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
